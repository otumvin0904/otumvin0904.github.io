/* =========================================
   NanoSpectroscopy Lab Homepage
   Main-page redesign
   - Existing masthead/navigation/search retained
   ========================================= */


/* =========================================
   PAGE / ACADEMICPAGES RESET
   ========================================= */

html {
    scroll-behavior: smooth;
}

.lab-home {
    width: 100%;
    margin: 0;
    padding: 18px 0 0;
    background: #fff;
}

.page__inner-wrap {
    max-width: none !important;
}

.page__content {
    margin: 0 !important;
    padding: 0 !important;
}

.page {
    width: 100% !important;
    padding: 0 !important;
}

.archive {
    width: 100% !important;
}

/* 홈페이지에서 AcademicPages 기본 제목 공간 제거 */
.page__title {
    display: none !important;
}

.lab-shell {
    width: calc(100% - 36px);
    max-width: 1480px;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
}


/* =========================================
   HERO
   ========================================= */

.hero {
    position: relative;
    min-height: 350px;
    overflow: hidden;

    background-image:
        linear-gradient(
            90deg,
            rgba(2, 18, 43, 0.98) 0%,
            rgba(3, 29, 67, 0.92) 28%,
            rgba(3, 28, 66, 0.63) 47%,
            rgba(3, 25, 58, 0.15) 72%,
            rgba(3, 25, 58, 0.05) 100%
        ),
        url("/images/homepage/hero.jpg");

    /* 첫 번째는 gradient, 두 번째는 hero.jpg */
    background-size:
        100% 100%,
        70% auto;

    background-position:
        center,
        right center;

    background-repeat:
        no-repeat,
        no-repeat;

    background-color: #031a3b;
}

.hero-overlay {
    width: 100%;
    min-height: 350px;
    display: flex;
    align-items: center;

    padding: 46px 74px 58px;
    box-sizing: border-box;
}

.hero-content {
    width: min(620px, 52%);
    color: #fff;
}

.hero h1 {
    margin: 0 0 20px;
    color: #fff;

    font-size: clamp(30px, 2.25vw, 40px);
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: -0.035em;
    word-break: keep-all;
}

.hero-accent {
    color: #fff;
    font-weight: 700;
}

.hero-description {
    margin: 0 0 26px;

    color: rgba(255,255,255,.78);
    font-size: 15px;
    line-height: 1.7;
    font-weight: 400;
}

.hero-button {
    display: inline-flex;
    align-items: center;
    gap: 15px;

    padding: 11px 20px;

    border: 1px solid #1789d8;
    border-radius: 3px;
    background: rgba(3, 33, 72, .42);

    color: #fff !important;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none !important;

    transition:
        background-color .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.hero-button:hover {
    background: rgba(15, 112, 177, .35);
    border-color: #29a7ff;
    transform: translateY(-1px);
}

.hero-dots {
    position: absolute;
    left: 50%;
    bottom: 20px;

    display: flex;
    gap: 8px;

    transform: translateX(-50%);
}

.hero-dot {
    width: 9px;
    height: 9px;

    border: 1px solid #1da2f4;
    border-radius: 50%;
    background: transparent;
}

.hero-dot.is-active {
    border-color: #fff;
    background: #fff;
}


/* =========================================
   HOME DASHBOARD
   ========================================= */

.home-dashboard {
    display: grid;
    grid-template-columns: 1.05fr 1.2fr .75fr;

    min-height: 255px;

    border-left: 1px solid #d7dce3;
    border-right: 1px solid #d7dce3;
    border-bottom: 1px solid #e7e9ed;

    background: #fff;
}

.dashboard-column {
    min-width: 0;
    padding: 25px 36px 28px;
    box-sizing: border-box;
}

.dashboard-column + .dashboard-column {
    border-left: 1px solid #d7dce3;
}

.dashboard-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 16px;
}

.dashboard-heading h2 {
    margin: 0;

    color: #082457;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
}

.dashboard-heading a {
    flex: 0 0 auto;

    color: #315d9d !important;
    font-size: 11px;
    font-weight: 600;
    text-decoration: none !important;
}


/* NEWS */

.home-news-list {
    display: flex;
    flex-direction: column;
}

.home-news-item {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    gap: 14px;

    padding: 11px 0;
    border-bottom: 1px solid #e7e9ed;

    color: #252b33 !important;
    font-size: 12.5px;
    line-height: 1.45;
    text-decoration: none !important;
}

.home-news-item:last-child {
    border-bottom: 0;
}

.home-news-item time {
    color: #525d6a;
    font-size: 11.5px;
    white-space: nowrap;
}

.home-news-item:hover span {
    color: #126db3;
}


/* PUBLICATIONS */

.home-publication-list {
    display: flex;
    flex-direction: column;
}

.home-publication-item {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 9px;

    padding: 9px 0 10px;
    border-bottom: 1px solid #e7e9ed;

    color: #20262e !important;
    text-decoration: none !important;
}

.home-publication-item:last-child {
    border-bottom: 0;
}

.publication-bullet {
    width: 4px;
    height: 4px;

    margin-top: 7px;

    border-radius: 50%;
    background: #0a316d;
}

.home-publication-item strong {
    display: block;

    font-size: 12.5px;
    line-height: 1.45;
    font-weight: 500;
}

.home-publication-item p {
    margin: 3px 0 0;

    color: #727a84;
    font-size: 11px;
    line-height: 1.45;
}

.home-publication-item:hover strong {
    color: #126db3;
}


/* PEOPLE */

/* =========================================
   PEOPLE
   ========================================= */

.professor-card {
    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: flex-start;

    width: 100%;

    padding-top: 10px;

    color: #232932 !important;
    text-decoration: none !important;

    box-sizing: border-box;
}


/* 교수 사진 */

.professor-photo {
    flex: none;

    width: 100px;
    height: 100px;

    margin: 0 0 18px;

    border-radius: 50%;

    background-color: #dce2e8;
    background-image: url("/images/homepage/professor.jpg");
    background-size: cover;
    background-position: center top;

    box-shadow:
        inset 0 0 0 1px rgba(0,0,0,.04);
}


/* 교수 정보 */

.professor-info {
    display: flex;
    flex-direction: column;

    width: 100%;

    align-items: center;

    padding: 0;

    text-align: center;

    box-sizing: border-box;
}


/* 교수 이름 */

.professor-info strong {
    margin: 0 0 8px;

    color: #20262e;

    font-size: 15px;
    line-height: 1.4;

    font-weight: 700;
}


/* 소속 / 이메일 / 전화번호 */

.professor-info span {
    display: block;

    margin: 1px 0;

    color: #68727d;

    font-size: 12px;
    line-height: 1.55;

    word-break: normal;
    overflow-wrap: anywhere;
}


/* =========================================
   FOOTER - FINAL RESPONSIVE VERSION
   ========================================= */

.lab-footer {
    position: relative;

    display: grid;

    grid-template-columns:
        minmax(360px, 1.25fr)
        minmax(360px, 1.45fr)
        minmax(220px, 0.85fr)
        42px;

    align-items: center;

    gap: 32px;

    width: calc(100% - 36px);
    max-width: 1480px;

    margin: 16px auto 0;

    padding: 30px 55px;

    box-sizing: border-box;

    background: linear-gradient(
        90deg,
        #031a3b 0%,
        #05234d 55%,
        #031a3b 100%
    );

    color: rgba(255, 255, 255, 0.72);
}


/* =========================================
   LEFT : KNU LOGO + LAB NAME
   ========================================= */

.footer-brand {
    display: flex;

    align-items: center;

    gap: 24px;

    min-width: 0;
}


/* 왼쪽에 로고 이미지가 여러 개 있어도 정상 배치 */

.footer-brand img {
    display: block;

    width: auto;
    max-width: 260px;
    max-height: 95px;

    object-fit: contain;

    flex-shrink: 0;
}


/* 학교명 + Lab name */

.footer-brand > div:last-child {
    display: flex;
    flex-direction: column;

    min-width: 150px;

    white-space: nowrap;
}


.footer-brand strong {
    margin: 0;

    color: rgba(255, 255, 255, 0.9);

    font-size: 13px;
    line-height: 1.55;

    font-weight: 600;
}


.footer-brand span {
    margin-top: 3px;

    color: rgba(255, 255, 255, 0.72);

    font-size: 12px;
    line-height: 1.5;
}


/* =========================================
   CENTER : ADDRESS
   ========================================= */

.footer-contact {
    min-width: 0;
}


.footer-contact p {
    margin: 0 !important;

    color: rgba(255, 255, 255, 0.72);

    font-size: 11.5px;
    line-height: 1.7;

    white-space: normal;

    word-break: keep-all;
}


/* 전화 / 이메일 사이 */

.footer-divider {
    display: inline-block;

    padding: 0 8px;

    color: rgba(255,255,255,.3);
}


/* =========================================
   RIGHT : COPYRIGHT
   ========================================= */

.footer-copy {
    min-width: 0;
}


.footer-copy p {
    margin: 0 !important;

    color: rgba(255, 255, 255, 0.72);

    font-size: 11px;
    line-height: 1.65;

    white-space: normal;

    word-break: keep-all;
}


/* =========================================
   TOP BUTTON
   ========================================= */

.footer-top {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;

    justify-self: end;

    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50%;

    color: rgba(255,255,255,.85) !important;

    font-size: 17px;

    text-decoration: none !important;
}


/* =========================================
   1200px 이하
   ========================================= */

@media (max-width: 1200px) {

    .lab-footer {

        grid-template-columns:
            minmax(320px, 1.2fr)
            minmax(320px, 1.4fr)
            42px;

        gap: 26px;

        padding: 28px 40px;
    }


    /* Copyright를 두 번째 줄로 */

    .footer-copy {
        grid-column: 1 / 3;

        margin-top: 4px;
    }


    .footer-top {
        grid-column: 3;
        grid-row: 1 / 3;

        align-self: center;
    }

}


/* =========================================
   TABLET
   ========================================= */

@media (max-width: 850px) {

    .lab-footer {

        grid-template-columns:
            minmax(0, 1fr)
            42px;

        gap: 22px;

        width: calc(100% - 20px);

        padding: 26px;
    }


    .footer-brand {
        grid-column: 1;
        grid-row: 1;
    }


    .footer-contact {
        grid-column: 1 / -1;
        grid-row: 2;
    }


    .footer-copy {
        grid-column: 1 / -1;
        grid-row: 3;

        margin-top: 0;
    }


    .footer-top {
        grid-column: 2;
        grid-row: 1;

        align-self: center;
    }


    .footer-brand img {
        max-width: 220px;
    }

}


/* =========================================
   MOBILE
   ========================================= */

@media (max-width: 600px) {

    .lab-footer {

        display: block;

        padding: 24px 20px;
    }


    .footer-brand {
        margin-bottom: 22px;
    }


    .footer-brand img {
        max-width: 170px;
        max-height: 75px;
    }


    .footer-brand > div:last-child {
        min-width: 0;

        white-space: normal;
    }


    .footer-contact {
        margin-bottom: 18px;
    }


    .footer-copy {
        margin-bottom: 18px;
    }


    .footer-top {
        margin-left: auto;
    }


    .footer-brand strong {
        font-size: 11px;
    }


    .footer-brand span,
    .footer-contact p,
    .footer-copy p {
        font-size: 10px;
    }

}


/* =========================================
   HEADER
   ========================================= */

.masthead__inner-wrap {
    width: 100% !important;
    max-width: 1280px !important;
    margin: 0 auto !important;
    padding-left: 52px !important;
    padding-right: 52px !important;
    box-sizing: border-box !important;
}

.masthead__menu,
.greedy-nav {
    width: 100% !important;
    min-width: 0 !important;
}

.masthead ul,
.masthead li,
.greedy-nav ul,
.greedy-nav li {
    list-style: none !important;
}

.masthead li::marker,
.greedy-nav li::marker {
    content: "" !important;
}

.greedy-nav {
    display: flex !important;
    align-items: center !important;
}

.greedy-nav .visible-links {
    display: flex !important;
    align-items: center !important;
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
}

.greedy-nav .visible-links > li:first-child {
    margin-left: 0 !important;
    margin-right: auto !important;
}


/* Logo */

.site-logo-link {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    height: 62px !important;
    padding: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
}

.site-logo-link::before,
.site-logo-link::after {
    display: none !important;
    content: none !important;
}

.site-logo {
    display: block !important;
    width: 132px !important;
    max-width: 132px !important;
    height: 48px !important;
    object-fit: contain !important;
    object-position: left center !important;
}

.masthead__menu-item--lg.selected,
.masthead__menu-item--lg.selected > a,
.masthead__menu-item--lg.persist > a {
    border-bottom: 0 !important;
    box-shadow: none !important;
}


/* Menu */

.greedy-nav .visible-links > li:not(:first-child) > a {
    padding-left: 9px !important;
    padding-right: 9px !important;
    font-size: 12.5px !important;
    font-weight: 400 !important;
    white-space: nowrap !important;
}


/* =========================================
   SEARCH BUTTON
   ========================================= */

/* Contact와 돋보기 사이 간격 */
.search-menu-item {
    display: flex !important;
    align-items: center !important;
    margin-left: 18px !important;
}

.site-search-button {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 36px !important;
    height: 36px !important;
    padding: 0 !important;
    margin: 0 !important;

    border: 0 !important;
    border-radius: 50% !important;
    background: transparent !important;
    color: #333 !important;
    cursor: pointer !important;

    appearance: none !important;
    -webkit-appearance: none !important;
}

.site-search-button:hover {
    background: #f1f3f5 !important;
    color: #0b55b5 !important;
}

.site-search-icon {
    display: block !important;
    width: 20px !important;
    height: 20px !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 2 !important;
    stroke-linecap: round !important;
}


/* =========================================
   SAME-PAGE SEARCH PANEL
   ========================================= */

.site-search-panel {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 999999;

    width: 100%;
    min-height: 86px;

    background: #e8e8e8;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);

    transition:
        opacity .18s ease,
        visibility .18s ease,
        transform .18s ease;

    box-shadow: 0 1px 7px rgba(0,0,0,.10);
}

.site-search-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
}

.site-search-panel__inner {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) 48px;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 22px;
    box-sizing: border-box;
}

.site-search-close {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 34px;
    height: 34px;
    margin-top: 7px;
    padding: 0;

    border: 0;
    background: transparent;
    color: #555;
    cursor: pointer;
}

.site-search-close svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.site-search-main {
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
}

.site-search-box {
    display: flex;
    align-items: center;
    width: 100%;
    height: 50px;
    padding: 0 16px;
    box-sizing: border-box;

    border-radius: 5px;
    background: #fff;

    box-shadow:
        0 2px 7px rgba(0,0,0,.18),
        0 1px 2px rgba(0,0,0,.08);
}

.site-search-box__icon {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    margin-right: 14px;
    fill: none;
    stroke: #555;
    stroke-width: 2;
    stroke-linecap: round;
}

#site-search-input {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;

    color: #333;
    font-family: inherit;
    font-size: 16px;
}

#site-search-input::placeholder {
    color: #777;
}

#site-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
}


/* Results */

.site-search-results-wrap {
    max-height: min(52vh, 420px);
    margin-top: 8px;
    overflow-y: auto;

    border-radius: 5px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(0,0,0,.16);
}

.site-search-count {
    padding: 10px 16px;
    border-bottom: 1px solid #eee;
    color: #777;
    font-size: 12px;
}

.site-search-result {
    display: block;
    padding: 13px 16px;
    border-bottom: 1px solid #eee;

    color: #222 !important;
    text-decoration: none !important;
}

.site-search-result:hover {
    background: #f7f8fa;
}

.site-search-result__title {
    margin-bottom: 5px;
    color: #111;
    font-size: 14px;
    font-weight: 600;
}

.site-search-result__description {
    color: #707070;
    font-size: 12px;
    line-height: 1.6;
}

.site-search-empty {
    padding: 22px 16px;
    color: #888;
    font-size: 13px;
    text-align: center;
}


/* Desktop */
@media (min-width: 1100px) {
    .greedy-nav > .greedy-nav__toggle {
        display: none !important;
    }
}


/* Tablet */
@media (max-width: 1099px) {
    .masthead__inner-wrap {
        padding-left: 28px !important;
        padding-right: 28px !important;
    }

    .site-logo {
        width: 120px !important;
        max-width: 120px !important;
        height: 44px !important;
    }

    .greedy-nav .visible-links > li:not(:first-child) > a {
        padding-left: 6px !important;
        padding-right: 6px !important;
        font-size: 12px !important;
    }

    .search-menu-item {
        margin-left: 12px !important;
    }
}

@media (max-width: 1000px) {
    .hero-overlay {
        padding: 68px 38px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .home-content {
        grid-template-columns: 1fr;
        padding: 42px 38px 64px;
    }
}


/* Mobile */
@media (max-width: 800px) {
    .masthead__inner-wrap {
        padding-left: 18px !important;
        padding-right: 18px !important;
    }

    .site-logo-link {
        height: 56px !important;
    }

    .site-logo {
        width: 112px !important;
        max-width: 112px !important;
        height: 42px !important;
    }

    .greedy-nav > .greedy-nav__toggle {
        display: block !important;
        order: 2 !important;
        margin-left: 10px !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
    }

    .site-search-panel__inner {
        grid-template-columns: 42px minmax(0, 1fr) 6px;
        padding: 12px 10px;
    }

    .site-search-box {
        height: 46px;
        padding: 0 14px;
    }

    .site-search-box__icon {
        width: 18px;
        height: 18px;
        margin-right: 12px;
    }

    #site-search-input {
        font-size: 15px;
    }
}

@media (max-width: 700px) {
    .hero {
        min-height: 430px;
    }

    .hero-overlay {
        padding: 56px 22px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero-description {
        font-size: 13px;
    }

    .home-content {
        display: block;
        padding: 32px 18px 54px;
    }

    .news-section {
        margin-bottom: 46px;
    }

    .research-grid {
        display: block;
    }

    .research-card {
        display: grid;
        grid-template-columns: 104px minmax(0, 1fr);
        gap: 13px;
        align-items: center;
        margin-bottom: 13px;
        padding-bottom: 13px;
        border-bottom: 1px solid #eee;
    }

    .research-card img {
        width: 104px;
        height: 76px;
    }

    .research-text {
        padding: 0;
    }
}


/* =========================================
   FINAL MAIN-PAGE OVERRIDES
   These rules intentionally come after the
   retained header/search CSS.
   ========================================= */

.lab-home .hero {
    min-height: 350px !important;
}

.lab-home .hero-overlay {
    min-height: 350px !important;
    max-width: none !important;
    padding: 46px 74px 58px !important;
}

.lab-home .hero h1 {
    font-size: clamp(30px, 2.25vw, 40px) !important;
    line-height: 1.4 !important;
}

.lab-home .hero-description {
    max-width: none !important;
    margin-bottom: 26px !important;
    font-size: 15px !important;
    line-height: 1.7 !important;
}

.lab-home .hero-button {
    padding: 11px 20px !important;
    background: rgba(3, 33, 72, .42) !important;
    color: #fff !important;
    border: 1px solid #1789d8 !important;
}

@media (max-width: 760px) {

    .lab-home .hero {
        min-height: 420px !important;
    }

    .lab-home .hero-overlay {
        min-height: 420px !important;
        padding: 48px 26px 64px !important;
    }

    .lab-home .hero h1 {
        font-size: 30px !important;
        line-height: 1.45 !important;
    }

    .lab-home .hero-description {
        font-size: 13px !important;
    }
}

@media (max-width: 430px) {
    .lab-home .hero h1 {
        font-size: 27px !important;
    }

    .lab-home .hero-overlay {
        padding-left: 21px !important;
        padding-right: 21px !important;
    }
}
/* =========================================
   DESKTOP NAV FIX
   ========================================= */

@media (min-width: 1100px) {

    .greedy-nav .visible-links {
        display: flex !important;
        align-items: center !important;
        width: 100% !important;
        flex-wrap: nowrap !important;
    }

    .greedy-nav .visible-links > li {
        flex-shrink: 0 !important;
    }

    .greedy-nav .visible-links > li:first-child {
        margin-right: auto !important;
    }

    .greedy-nav .visible-links > li > a {
        white-space: nowrap !important;
    }

}
/* =========================================
   HOME NEWS / PUBLICATION TEXT LIMIT
   ========================================= */


/* =========================
   NEWS
   ========================= */

.home-news-item {
    display: grid;

    grid-template-columns:
        92px minmax(0, 1fr);

    gap: 14px;

    align-items: start;

    min-height: 52px;

    padding: 10px 0;

    box-sizing: border-box;
}


/* 날짜 */

.home-news-item time {
    white-space: nowrap;
}


/* News 내용:
   최대 2줄까지만 표시 */

.home-news-text {
    display: -webkit-box;

    overflow: hidden;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;

    line-clamp: 2;

    text-overflow: ellipsis;

    line-height: 1.45;

    max-height: calc(1.45em * 2);

    word-break: keep-all;
}


/* =========================
   PUBLICATIONS
   ========================= */

.home-publication-item {
    display: grid;

    grid-template-columns:
        6px minmax(0, 1fr);

    gap: 10px;

    align-items: start;

    min-height: 65px;

    padding: 10px 0;

    box-sizing: border-box;
}


.home-publication-content {
    min-width: 0;
}


/* 논문 제목:
   최대 2줄 */

.home-publication-title {
    display: -webkit-box;

    overflow: hidden;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;

    line-clamp: 2;

    text-overflow: ellipsis;

    line-height: 1.4;

    max-height: calc(1.4em * 2);

    word-break: keep-all;
}


/* 저널:
   한 줄 이상이면 ... */

.home-publication-journal {
    display: block;

    overflow: hidden;

    margin: 4px 0 0 !important;

    white-space: nowrap;

    text-overflow: ellipsis;

    line-height: 1.4;
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 700px) {

    .home-news-item {
        grid-template-columns:
            82px minmax(0, 1fr);

        gap: 10px;
    }

    .home-news-text {
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    .home-publication-title {
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

}
/* =========================================================
   MAIN HOMEPAGE - FLUID SCALE
   ========================================================= */

:root {
    /*
      전체 홈페이지 최대 크기
      94vw = 화면 너비의 94%
      1560px = 아무리 큰 화면이어도 최대 1560px
    */
    --lab-main-width: min(94vw, 1560px);
}


/* =========================================================
   HEADER
   ========================================================= */

.masthead__inner-wrap {
    width: var(--lab-main-width) !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;

    padding-left: 0 !important;
    padding-right: 0 !important;
}


/* 로고도 약간 확대 */

.site-logo {
    width: clamp(125px, 8.5vw, 155px) !important;
    max-width: none !important;

    height: auto !important;
}


/* 상단 메뉴 */

.greedy-nav .visible-links > li:not(:first-child) > a {
    font-size: clamp(12px, 0.82vw, 14px) !important;

    padding-left: clamp(7px, 0.65vw, 12px) !important;
    padding-right: clamp(7px, 0.65vw, 12px) !important;
}


/* =========================================================
   MAIN WRAPPER
   HERO / NEWS / PUBLICATIONS / PEOPLE
   ========================================================= */

.lab-shell {
    width: var(--lab-main-width) !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;
}


/* =========================================================
   HERO
   ========================================================= */

.lab-home .hero {
    /*
      폭에 따라 높이도 같이 변해서
      사진 비율이 유지되도록 설정
    */
    width: var(--lab-main-width) !important;

    min-height: 0 !important;

    aspect-ratio: 3.25 / 1 !important;
}


.lab-home .hero-overlay {
    width: 100% !important;
    height: 100% !important;

    min-height: 0 !important;

    padding:
        clamp(40px, 4.2vw, 72px)
        clamp(48px, 5.5vw, 90px) !important;
}


/* Hero 글자도 화면에 맞춰 확대/축소 */

.lab-home .hero h1 {
    font-size: clamp(30px, 2.35vw, 42px) !important;
    line-height: 1.35 !important;
}


.lab-home .hero-description {
    font-size: clamp(13px, 1vw, 16px) !important;
    line-height: 1.7 !important;
}


.lab-home .hero-button {
    font-size: clamp(12px, 0.9vw, 14px) !important;

    padding:
        clamp(10px, 0.8vw, 13px)
        clamp(18px, 1.5vw, 24px) !important;
}


/* =========================================================
   NEWS / PUBLICATIONS / PEOPLE
   ========================================================= */

.home-dashboard {
    width: var(--lab-main-width) !important;

    grid-template-columns:
        minmax(0, 1.05fr)
        minmax(0, 1.25fr)
        minmax(210px, 0.65fr) !important;
}


/* 각 영역 padding도 유동적으로 */

.dashboard-column {
    padding:
        clamp(22px, 2vw, 32px)
        clamp(24px, 2.4vw, 38px) !important;
}


/* 제목 */

.dashboard-heading h2 {
    font-size: clamp(18px, 1.25vw, 22px) !important;
}


/* 더보기 */

.dashboard-heading a {
    font-size: clamp(10px, 0.75vw, 12px) !important;
}


/* News */

.home-news-item {
    grid-template-columns:
        clamp(75px, 6vw, 100px)
        minmax(0, 1fr) !important;

    gap: clamp(10px, 1vw, 16px) !important;
}


.home-news-item time {
    font-size: clamp(10px, 0.78vw, 12px) !important;
}


.home-news-text {
    font-size: clamp(11px, 0.82vw, 13px) !important;
}


/* Publications */

.home-publication-title {
    font-size: clamp(11px, 0.88vw, 14px) !important;
}


.home-publication-journal {
    font-size: clamp(9px, 0.72vw, 11.5px) !important;
}


/* =========================================================
   PEOPLE
   ========================================================= */

.professor-photo {
    width: clamp(88px, 7vw, 115px) !important;
    height: clamp(88px, 7vw, 115px) !important;
}


.professor-info strong {
    font-size: clamp(13px, 0.95vw, 16px) !important;
}


.professor-info span {
    font-size: clamp(10px, 0.78vw, 12px) !important;
}
/* =========================================================
   KEEP DESKTOP PROPORTION LONGER
   ========================================================= */

@media (min-width: 851px) {

    .home-dashboard {
        display: grid !important;

        grid-template-columns:
            minmax(0, 1.05fr)
            minmax(0, 1.25fr)
            minmax(190px, 0.65fr) !important;
    }


    .people-column {
        grid-column: auto !important;

        border-top: 0 !important;
        border-left: 1px solid #d7dce3 !important;
    }

}
/* =========================================================
   HOMEPAGE CENTER ALIGNMENT FIX
   ========================================================= */

/* AcademicPages 기본 page 위치/폭 제한 완전 제거 */
#main {
    width: 100% !important;
    max-width: none !important;

    margin-left: 0 !important;
    margin-right: 0 !important;

    padding-left: 0 !important;
    padding-right: 0 !important;
}


/* 오른쪽으로 밀리는 원인 제거 */
.page {
    float: none !important;

    width: 100% !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;

    padding-left: 0 !important;
    padding-right: 0 !important;
}


/* 내부 wrapper도 화면 전체 기준 */
.page__inner-wrap {
    width: 100% !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;

    padding-left: 0 !important;
    padding-right: 0 !important;
}


/* 실제 본문 */
.page__content {
    width: 100% !important;
    max-width: none !important;

    margin: 0 !important;
    padding: 0 !important;
}


/* 홈페이지 자체 */
.lab-home {
    width: 100% !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;
}


/* Hero / Dashboard / Footer의 기준 폭 통일 */
.lab-home .lab-shell,
.lab-home .hero,
.lab-home .home-dashboard,
.lab-home .lab-footer {
    width: min(94vw, 1560px) !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;
}